{
  "name": "@beckchiang/dsh-cost-meter",
  "version": "2.0.0",
  "description": "Per-step session cost meter for the DeepSeek Harness composer dock: cumulative cost split, this-turn/last-turn cost, peak/off-peak pricing frozen at each request's start time, and context-vs-budget advice for when to hand off.",
  "type": "module",
  "license": "MIT",
  "author": "BeckChiang",
  "homepage": "https://github.com/BeckChiang/dsh-cost-meter#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BeckChiang/dsh-cost-meter.git"
  },
  "bugs": {
    "url": "https://github.com/BeckChiang/dsh-cost-meter/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "cost",
    "billing",
    "token",
    "usage",
    "pricing",
    "peak",
    "composer",
    "dock"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/ledger.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
